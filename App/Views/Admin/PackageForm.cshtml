@model HotPackageDTO
@{
    bool isEdit = Model.PackageId > 0;
    ViewData["Title"] = isEdit ? "Edit Hot Deal" : "Add Hot Deal";
    var hotels = ViewBag.Hotels as List<HotelDTO> ?? new List<HotelDTO>();
}

<h2>@ViewData["Title"]</h2>
<hr />

<div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

@if (isEdit)
{
    <form method="post" asp-controller="Admin" asp-action="EditPackage" asp-route-id="@Model.PackageId" style="max-width: 500px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="PackageId" value="@Model.PackageId" />
        <div class="mb-3">
            <label>Hotel <span class="text-danger">*</span></label>
            <select name="HotelId" class="form-select" required>
                <option value="">-- Select Hotel --</option>
                @foreach (var h in hotels)
                {
                    <option value="@h.HotelId" selected="@(Model.HotelId == h.HotelId)">@h.Name (@h.City)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Title <span class="text-danger">*</span></label>
            <input name="Title" class="form-control" value="@Model.Title" required />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
        </div>
        <div class="mb-3">
            <label>Price (BDT) <span class="text-danger">*</span></label>
            <input name="Price" type="number" step="0.01" min="0" class="form-control" value="@Model.Price" required />
        </div>
        <div class="mb-3">
            <label>Valid Until <span class="text-danger">*</span></label>
            <input name="ValidUntil" type="date" class="form-control"
                   value="@Model.ValidUntil.ToString("yyyy-MM-dd")" required />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Admin" asp-action="Packages" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <form method="post" asp-controller="Admin" asp-action="CreatePackage" style="max-width: 500px;">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>Hotel <span class="text-danger">*</span></label>
            <select name="HotelId" class="form-select" required>
                <option value="">-- Select Hotel --</option>
                @foreach (var h in hotels)
                {
                    <option value="@h.HotelId">@h.Name (@h.City)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Title <span class="text-danger">*</span></label>
            <input name="Title" class="form-control" value="@Model.Title" required />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
        </div>
        <div class="mb-3">
            <label>Price (BDT) <span class="text-danger">*</span></label>
            <input name="Price" type="number" step="0.01" min="0" class="form-control" value="@Model.Price" required />
        </div>
        <div class="mb-3">
            <label>Valid Until <span class="text-danger">*</span></label>
            <input name="ValidUntil" type="date" class="form-control"
                   value="@Model.ValidUntil.ToString("yyyy-MM-dd")" required />
        </div>
        <button type="submit" class="btn btn-primary">Add Hot Deal</button>
        <a asp-controller="Admin" asp-action="Packages" class="btn btn-secondary">Cancel</a>
    </form>
}
