@model List<HotPackageDTO>
@{
    ViewData["Title"] = "Admin - Hot Deals";
}

<h2>Manage Hot Deals</h2>
<a asp-controller="Admin" asp-action="CreatePackage" class="btn btn-primary mb-3">Add Hot Deal</a>
<hr />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Hotel</th>
            <th>City</th>
            <th>Price</th>
            <th>Valid Until</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            string statusBadge = p.ValidUntil >= DateTime.Today ? "bg-success" : "bg-secondary";
            string statusText = p.ValidUntil >= DateTime.Today ? "Active" : "Expired";

            <tr>
                <td>@p.Title</td>
                <td>@p.HotelName</td>
                <td>@p.HotelCity</td>
                <td>BDT @p.Price.ToString("N0")</td>
                <td>@p.ValidUntil.ToString("dd MMM yyyy")</td>
                <td><span class="badge @statusBadge">@statusText</span></td>
                <td>
                    <a asp-controller="Admin" asp-action="PackageDetails" asp-route-id="@p.PackageId" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-controller="Admin" asp-action="EditPackage" asp-route-id="@p.PackageId" class="btn btn-sm btn-primary">Edit</a>
                    <form method="post" asp-controller="Admin" asp-action="DeletePackage" asp-route-id="@p.PackageId" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete this deal?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
